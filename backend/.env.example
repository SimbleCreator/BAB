# Copy to .env and adjust. Never commit .env.
BAB_ENV=development
BAB_DATABASE_URL=postgresql+asyncpg://bab:bab_dev_password@localhost:5432/bab
BAB_TEST_DATABASE_URL=postgresql+asyncpg://bab:bab_dev_password@localhost:5432/bab_test
BAB_FRONTEND_ORIGIN=http://localhost:4200
BAB_CONTACT_EMAIL=owner@example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BAB_JWT_SECRET=dev-only-secret-never-use-in-production-0000
# Cross-site deployments (frontend and API on different sites) need: none
BAB_COOKIE_SAMESITE=lax
# Production only (container): BAB_ENV=production is set by the Dockerfile.
# FORWARDED_ALLOW_IPS=<proxy ip>  RUN_MIGRATIONS=1  PORT=8000

# Bounce (AI coach). Any OpenAI-compatible endpoint works. Default: OpenRouter free models.
# Create a key at https://openrouter.ai/settings/keys (free account, no card).
# Leave the key empty to switch Bounce off.
BAB_AI_API_KEY=
BAB_AI_BASE_URL=https://openrouter.ai/api/v1
BAB_AI_MODEL=google/gemma-4-31b-it:free
# Tried in order when the main model is busy (OpenRouter only).
BAB_AI_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
